import pandas as pd
from pathlib import Path

from sklearn.model_selection import train_test_split, GridSearchCV, StratifiedKFold
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report, roc_auc_score

def resolve_data_file(filename: str) -> Path:
    start = Path(__file__).resolve().parent
    for base in (start, *start.parents):
        candidate = base / "data" / "processed" / filename
        if candidate.exists():
            return candidate
    raise FileNotFoundError(f"Could not find {filename} under any parent data/processed directory.")


data_path = resolve_data_file("step3_hfacs_categories.csv")
df = pd.read_csv(data_path)

# ---- X (features) ----
Xcols = ["Condition_of_Operators", "Personnel_Factors", "Situational_Factors"]
X = df[Xcols].astype(int)

# ---- Y (two labels) ----
Ycols = ["Error", "Violation"]
Y = df[Ycols].astype(int)

# Optional: stratify by label-pattern (00,01,10,11) if possible
strat = Y.astype(str).agg("".join, axis=1)
try:
    Xtr, Xte, Ytr, Yte = train_test_split(X, Y, test_size=0.2, random_state=7, stratify=strat)
except ValueError:
    # fallback if some patterns are too rare
    Xtr, Xte, Ytr, Yte = train_test_split(X, Y, test_size=0.2, random_state=7, stratify=Y["Violation"])

# ---- pipeline ----
pipe = Pipeline([
    ("poly", PolynomialFeatures(include_bias=False, interaction_only=True)),
    ("clf", LogisticRegression(max_iter=5000, class_weight="balanced", solver="liblinear")),
])

param_grid = {
    "poly__degree": [1, 2],             # 1=no interactions, 2=pairwise interactions
    "clf__C": [0.01, 0.1, 1, 10, 100],
}

cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=7)

# ---- train + evaluate one model per label ----
for target in Ycols:
    gs = GridSearchCV(pipe, param_grid, scoring="f1", cv=cv)
    gs.fit(Xtr, Ytr[target])

    pred = gs.predict(Xte)
    proba = gs.predict_proba(Xte)[:, 1]

    print("\n==============================")
    print("Target:", target)
    print("Best:", gs.best_params_)
    print(classification_report(Yte[target], pred, target_names=[f"no_{target}", target]))
    print("AUC:", roc_auc_score(Yte[target], proba))